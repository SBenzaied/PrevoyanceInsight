@page "/comparaison"
@using MediatR
@using PrevoyanceInsight.Application.Common
@using PrevoyanceInsight.Application.Plans.Queries
@using PrevoyanceInsight.Domain.Entities
@using PrevoyanceInsight.Domain.ValueObjects
@inject ISender Mediator
@inject IPlanRepository PlanRepository

<PageTitle>Comparaison des plans de prévoyance</PageTitle>

<div class="page-header">
    <h1>Comparaison de plans</h1>
    <p>Comparez deux plans de prévoyance sur leurs taux de couverture, de cotisation et technique.</p>
</div>

@if (plans is null)
{
    <div class="empty-state">Chargement des plans...</div>
}
else
{
    <div class="card section-gap">
        <div class="card-content">
            <div class="toolbar" style="margin-bottom:0;">
                <div class="field">
                    <label for="planA">Plan A</label>
                    <select id="planA" @bind="planIdA">
                        <option value="">Sélectionner...</option>
                        @foreach (PlanPrevoyance plan in plans)
                        {
                            <option value="@plan.Id">@plan.Nom</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="planB">Plan B</label>
                    <select id="planB" @bind="planIdB">
                        <option value="">Sélectionner...</option>
                        @foreach (PlanPrevoyance plan in plans)
                        {
                            <option value="@plan.Id">@plan.Nom</option>
                        }
                    </select>
                </div>

                <button class="btn btn-primary" @onclick="ComparerAsync" disabled="@(string.IsNullOrEmpty(planIdA) || string.IsNullOrEmpty(planIdB))">
                    Comparer
                </button>
            </div>
        </div>
    </div>

    @if (comparaison is not null)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title">@comparaison.NomPlanA vs @comparaison.NomPlanB</div>
            </div>
            <div class="card-content">
                <div class="stat-grid">
                    <div class="stat-card">
                        <div class="stat-label">Écart taux de couverture</div>
                        <div class="stat-value">@comparaison.EcartTauxCouverture.ToString("P1")</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Écart taux de cotisation total</div>
                        <div class="stat-value">@comparaison.EcartTauxCotisationTotal.ToString("P1")</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Écart taux technique</div>
                        <div class="stat-value">@comparaison.EcartTauxTechnique.ToString("P1")</div>
                    </div>
                </div>
                <p class="muted">@comparaison.Synthese</p>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<Domain.Entities.PlanPrevoyance>? plans;
    private string planIdA = string.Empty;
    private string planIdB = string.Empty;
    private ComparaisonPlans? comparaison;

    protected override async Task OnInitializedAsync()
    {
        plans = await PlanRepository.ListerTousAsync();
    }

    private async Task ComparerAsync()
    {
        comparaison = await Mediator.Send(new ComparerPlansQuery(Guid.Parse(planIdA), Guid.Parse(planIdB)));
    }
}
